[Unit]
Description=NanoPi sing-box web UI
After=network-online.target sing-box.service
Wants=network-online.target
# Не крутить перезапуски бесконечно: не больше 10 стартов за 5 минут.
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
# Не убивать побочные процессы в cgroup (setsid fallback apply).
KillMode=process
EnvironmentFile=-/opt/nanopi-edge/.env
Environment=WEBUI_ENV=/opt/nanopi-edge/.env
ExecStart=/usr/local/bin/nanopi-webui
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=multi-user.target
